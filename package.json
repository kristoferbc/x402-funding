{
  "name": "x402-funding-divergence",
  "version": "1.2.0",
  "mcpName": "io.github.kristoferbc/x402-funding",
  "description": "Perpetual funding-rate divergence between Hyperliquid and a liquid CEX benchmark (Binance, or OKX where Binance restricts the region): annualized with each venue's real funding interval, liquidity-filtered on both legs, with the basis-trade direction resolved. Library, MCP tool, and paid x402 endpoint.",
  "type": "module",
  "main": "src/sensor.mjs",
  "bin": {
    "x402-funding-mcp": "src/mcp-server.mjs",
    "x402-funding-divergence": "src/mcp-server.mjs"
  },
  "exports": {
    ".": "./src/sensor.mjs"
  },
  "files": [
    "src/",
    "README.md",
    ".env.example",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kristoferbc/x402-funding.git"
  },
  "homepage": "https://github.com/kristoferbc/x402-funding#readme",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "sensor": "node src/test-sensor.mjs",
    "mcp": "node src/mcp-server.mjs",
    "heartbeat": "node src/heartbeat.mjs",
    "measure": "node src/measure.mjs",
    "seed": "node src/seed.mjs",
    "check:lite": "node scripts/check-lite.mjs",
    "check:mcp": "node scripts/check-mcp.mjs",
    "verify": "node scripts/verify.mjs",
    "check": "npm run verify && npm run check:lite && npm run check:mcp && npm run sensor"
  },
  "keywords": [
    "hyperliquid",
    "binance",
    "okx",
    "funding-rate",
    "arbitrage",
    "x402",
    "ai-agents",
    "mcp",
    "perpetuals",
    "basis-trade",
    "crypto",
    "market-data",
    "defi",
    "agent-payments"
  ],
  "license": "MIT",
  "dependencies": {
    "@coinbase/cdp-sdk": "^1.60.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@x402/core": "^2.0.0",
    "@x402/evm": "^2.0.0",
    "@x402/express": "^2.0.0",
    "@x402/extensions": "^2.0.0",
    "@x402/fetch": "^2.29.0",
    "@x402/svm": "^2.29.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "zod": "^3.23.8"
  }
}
