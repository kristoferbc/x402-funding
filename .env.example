# Adresse EVM qui recoit les paiements.
# Adresse PUBLIQUE uniquement. Aucune cle privee de portefeuille sur le serveur.
PAY_TO=0xVotreAdresseReelle

# eip155:8453  = Base Mainnet (argent reel)
# eip155:84532 = Base Sepolia (testnet, gratuit)
NETWORK=eip155:8453

# Cles CDP — OBLIGATOIRES en mainnet.
# Dans le fichier JSON telecharge depuis portal.cdp.coinbase.com :
#   "id"         -> CDP_API_KEY_ID
#   "privateKey" -> CDP_API_KEY_SECRET
# Ne jamais committer ces valeurs.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Facultatif. Ne renseigner que pour surcharger l'URL par defaut du
# facilitateur CDP (https://api.cdp.coinbase.com/platform/v2/x402).
# FACILITATOR_URL=

# Prix par appel. 20000 = 0,02 USDC (6 decimales).
PRICE=$0.02

PORT=4021

# URL publique de l'endpoint paye, utilisee par measure.mjs a J+7
SELF_URL=https://votre-service.onrender.com/funding

# Keep-alive : empeche le tier gratuit de s'endormir
HEARTBEAT_MS=300000

# Nombre de pages du catalogue Bazaar a scanner pour se trouver
MAX_PAGES=120
