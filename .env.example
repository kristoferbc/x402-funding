# Adresse EVM qui recoit les paiements.
# Adresse PUBLIQUE uniquement. Aucune cle privee de portefeuille sur le serveur.
PAY_TO=0xVotreAdresseReelle

# eip155:8453  = Base Mainnet (argent reel)
# eip155:84532 = Base Sepolia (testnet, gratuit)
NETWORK=eip155:8453

# Cles CDP — OBLIGATOIRES en mainnet.
# Dans le fichier JSON telecharge depuis portal.cdp.coinbase.com :
#   "id"         -> CDP_API_KEY_ID
#   "privateKey" -> CDP_API_KEY_SECRET
# Ne jamais committer ces valeurs.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Facultatif. Ne renseigner que pour surcharger l'URL par defaut du
# facilitateur CDP (https://api.cdp.coinbase.com/platform/v2/x402).
# FACILITATOR_URL=

# Prix par appel. 20000 = 0,02 USDC (6 decimales).
PRICE=$0.02

# Planchers de liquidite. Les deux premiers portent sur Hyperliquid, le
# troisieme sur la venue de reference : une paire doit etre liquide des DEUX
# cotes pour que le portage soit executable.
MIN_OI_USD=1000000
MIN_VOL_USD=2000000
MIN_CEX_VOL_USD=2000000

# Au-dela de ce seuil, l'ecart est marque `anomaly` et recule dans le
# classement. 2000 bps = 20 points de pourcentage annualises.
ANOMALY_BPS=2000

# Ordre d'essai des venues de reference. Binance repond en Europe et en Asie
# mais renvoie 451 depuis les Etats-Unis ; OKX prend alors le relais.
# X402_BENCHMARK_ORDER=binance,okx

# Fenetre et profondeur du calcul de stabilite (moyenne et ecart-type des taux
# recents). Deux appels par ligne, donc borne au nombre de lignes indique.
STABILITY_WINDOW_HOURS=72
STABILITY_MAX_ROWS=10

PORT=4021

# URL publique de l'endpoint paye, utilisee par measure.mjs a J+7
SELF_URL=https://votre-service.onrender.com/funding

# Keep-alive : empeche le tier gratuit de s'endormir
HEARTBEAT_MS=300000

# Nombre de pages du catalogue Bazaar a scanner pour se trouver
MAX_PAGES=120
